# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Deployer private key (0x-prefixed). Use a throwaway/test key for testnet.
PRIVATE_KEY=0x...

# Sepolia RPC (Alchemy/Infura/private — see project notes on why public RPCs fail).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# For contract verification on Etherscan (optional but recommended).
ETHERSCAN_API_KEY=...

# Optional: protocol fee sink. Defaults to the deployer address if unset.
# TREASURY=0x...

# ---------------------------------------------------------------------------
# ts-client/flow.ts — full lifecycle driver
# ---------------------------------------------------------------------------
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# FUNDER_KEY=0x...        # creates the pool, mints mUSDC, settles rounds
#
# Addresses printed by the deploy script:
# FACTORY_ADDRESS=0x...
# REGISTRY_ADDRESS=0x...
# USDC_ADDRESS=0x...
#
# The three members' keys. Each member funds their OWN gas; the client does
# not send them ETH. On anvil these can be omitted (falls back to defaults).
# MEMBER1_KEY=0x...
# MEMBER2_KEY=0x...
# MEMBER3_KEY=0x...
#
# On a live network, set short round timings so the demo doesn't wait 12h:
# PERIOD_SECONDS=120
# WINDOW_SECONDS=60
# CONTRIBUTION=10000000   # 10 mUSDC (6 decimals)
