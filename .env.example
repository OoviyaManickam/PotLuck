# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Contract deploy (forge script script/Deploy.s.sol)
# ---------------------------------------------------------------------------
# Deployer private key (0x-prefixed). Use a throwaway/test key for testnet.
# This SAME key doubles as the pool creator in the demo below (CREATOR_PRIVATE_KEY),
# so you only fund 5 wallets total: this one + the 4 members.
PRIVATE_KEY=0x...

# Sepolia RPC (Alchemy/Infura/private — see project notes on why public RPCs fail).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# For contract verification on Etherscan (optional but recommended).
ETHERSCAN_API_KEY=...

# Optional: protocol fee sink. Defaults to the deployer address if unset.
# TREASURY=0x...

# ---------------------------------------------------------------------------
# ts-client/src/flow.ts — full lifecycle driver (Sepolia)
# ---------------------------------------------------------------------------
# Five explicit wallets: a creator + FOUR members (the demo runs an N=4 pool so
# a member can miss one round, get slashed, and still stay active). Each must
# ALREADY hold a little Sepolia ETH for gas; the script never sends them ETH.
# mUSDC is minted from the MockUSDC faucet.
#
# The creator is the pool operator only — it creates the pool and settles each
# round, and is NOT a pool member. Reuse the deployer key above as the creator.
CREATOR_PRIVATE_KEY=0x...   # = PRIVATE_KEY above; creates the pool, settles rounds
MEMBER1_PRIVATE_KEY=0x...
MEMBER2_PRIVATE_KEY=0x...
MEMBER3_PRIVATE_KEY=0x...
MEMBER4_PRIVATE_KEY=0x...

# Live deployed contract addresses on Sepolia (from broadcast/Deploy.s.sol/11155111).
TOKEN_ADDRESS=0xC35457B1e14763d21e70470cC3c139B62185a013
FACTORY_ADDRESS=0xbC39E3F9eC515677D37E711519d98eFA1198Be46
REGISTRY_ADDRESS=0x99623A04e6f11B1AcBfD98396da46e0640C79f19

# Demo pool timing. Keep the window short so one run settles all rounds without
# waiting hours. contribution is in mUSDC base units (6 decimals).
# PERIOD_SECONDS=180
# WINDOW_SECONDS=60
# CONTRIBUTION=10000000       # 10 mUSDC
